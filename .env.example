# Environment Configuration
# Note: For Vercel deployment, configure these in Vercel Project Settings > Environment Variables:

# Supabase Real History Persistence (Server-side ONLY - NEVER prefix with VITE_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional client settings:
# VITE_API_BASE_URL=
# Public phone-side Adaptive Learning endpoint (optional override; no credentials)
# VITE_ADAPTIVE_LEARNING_URL=https://remedies-flush-departmental-prime.trycloudflare.com/api/adaptive-learning/current
# VITE_SIMULATOR_ENV=TEST
# VITE_ENABLE_MOCK_API=true
