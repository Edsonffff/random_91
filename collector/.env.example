# Supabase Configuration
# Server-side service-role key (NEVER expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WingoAI Signal API — Bearer token (NEVER expose to frontend, GitHub, or logs)
WINGOAI_API_TOKEN=your-wingoai-bearer-token

# Polling Interval (in milliseconds, default is 30000 = 30 seconds)
POLL_INTERVAL_MS=30000

# Optional HTTP Port for cloud platforms (Render, Railway, Heroku) that require a bound port
PORT=8080
