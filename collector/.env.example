# Supabase Configuration
# Server-side service-role key (NEVER expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# BDGTharu uses an unauthenticated GET; no API token is required.

# Polling Interval (in milliseconds, default is 30000 = 30 seconds)
POLL_INTERVAL_MS=30000
RETRY_DELAY_MS=10000

# Durable history write-ahead spool. Keep this on persistent local storage.
# The default is .history-spool under the collector process working directory.
HISTORY_SPOOL_DIR=.history-spool
HISTORY_REQUEST_TIMEOUT_MS=15000
HISTORY_SUPABASE_TIMEOUT_MS=15000

# Destructive full reset is disabled by default. Enable only intentionally.
RESET_ENABLED=false
RESET_WAIT_TIMEOUT_MS=30000

# Optional HTTP Port for cloud platforms (Render, Railway, Heroku) that require a bound port
PORT=8080

# Clean Adaptive baseline cutover. The default retires the unrecoverable
# historical T7 gap at 20261002100050850 and auto-selects the first contiguous
# strictly finalized T7 prefix after it. Use only for local legacy recovery tests:
# ADAPTIVE_BASELINE_AFTER_PERIOD=disabled
